# انسخ هذا الملف لـ .env وغيّر القيم. لا ترفع .env لأي مكان.
PORT=3000
DATABASE_URL=postgres://clinic@127.0.0.1:5544/clinic_dev
# سر توقيع التوكن: 32 حرف على الأقل، عشوائي، لكل عيادة سر خاص
JWT_SECRET=غيّر-هذا-لسلسلة-عشوائية-طويلة-جداً-32-حرف-أو-أكثر
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
LOGIN_MAX_FAILURES=5
LOCK_MINUTES=15
LOGIN_RATE_LIMIT=10
# 1 إذا السيرفر خلف بروكسي (nginx) حتى يقرأ عنوان العميل الحقيقي
TRUST_PROXY=0
# مفتاح تشفير أسرار التحقق الثنائي للمالك: 32 بايت base64. ولّده بـ: openssl rand -base64 32
# مهم: ضياعه يعني ضياع تشفير الأسرار (المالك لازم يعيد تفعيل التحقق)، وكل عيادة مفتاح خاص.
TOTP_ENC_KEY=
# الاسم اللي يظهر بتطبيق المصادقة (اسم العيادة)
TOTP_ISSUER=Clinic
# مجلد الملفات المرفوعة (صور الإثبات). لازم ينحفظ بالنسخ الاحتياطي مع القاعدة
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=8388608

# المهام المجدولة (إقفال الأيام، الرواتب، الإشعارات). فعّلها بالإنتاج بنسخة وحدة أو أكثر (قفل استشاري)
SCHEDULER=0
SCHEDULER_INTERVAL_SECONDS=600
# حد طلبات رمز التأكيد بالدقيقة لكل IP
OTP_RATE_LIMIT=10

# CORS: قائمة أصول تطبيق الويب (فاضية = معطل). مثال: https://clinic.example.com
CORS_ORIGINS=

# للتجربة اليدوية فقط (يطبع رمز OTP بسجل الخادم؛ يتجاهل مع NODE_ENV=production)
OTP_DEV_LOG=0

# ===== النسخ الاحتياطي (راجع ops/backup/README.md) =====
# مكان التخزين البعيد: dir:/path (قرص خارجي/NAS) أو rclone:اسم_الريموت:الحاوية/المسار (أي تخزين S3)
BACKUP_REMOTE=
# المفتاح العام للتشفير (السيرفر يملك العام بس؛ الخاص عند المالك فقط)
BACKUP_PUBLIC_KEY=
BACKUP_SPOOL_DIR=/var/lib/clinic-backup/spool
BACKUP_STATE_DIR=/var/lib/clinic-backup/state
# للتنبيه عند فشل أي مهمة (يستلم الرسالة بمتغير BACKUP_ALERT_MESSAGE)، مثال: curl بـwebhook أو mail
BACKUP_ALERT_COMMAND=
