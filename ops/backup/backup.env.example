# /etc/clinic/backup.env  (chmod 640، مالكه root:clinic)
# التخزين البعيد (بره السيرفر وبره شركة الاستضافة). مثال Backblaze B2 أو Wasabi عبر rclone:
#   rclone config  (أنشئ ريموت اسمه offsite)   ثم:
BACKUP_REMOTE=rclone:offsite:clinic-backups/jasmine
# المفتاح العام للتشفير (السيرفر يملك العام فقط). الخاص عند المالك وما ينحط هنا أبداً.
BACKUP_PUBLIC_KEY=/etc/clinic/backup-public.pem
BACKUP_SPOOL_DIR=/var/lib/clinic-backup/spool
BACKUP_STATE_DIR=/var/lib/clinic-backup/state
BACKUP_WORK_DIR=/var/lib/clinic-backup/work
UPLOAD_DIR=/var/lib/clinic/uploads
DATABASE_URL=postgres://clinic_backup@/clinic?host=/var/run/postgresql
PGBIN=/usr/lib/postgresql/16/bin
# الاحتفاظ: 7 يومي + 4 أسبوعي + 12 شهري (الافتراضي)
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# تنبيه فوري عند الفشل: الرسالة بمتغير BACKUP_ALERT_MESSAGE. مثال (Telegram/Slack/أي webhook):
# BACKUP_ALERT_COMMAND=curl -fsS -X POST -d "text=$BACKUP_ALERT_MESSAGE" https://example.com/hook
